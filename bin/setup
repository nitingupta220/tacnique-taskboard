#!/usr/bin/env bash
#
# Manual setup (without Docker).
# Requires: Python 3.12+, Node.js 20+, PostgreSQL 15+

set -e

cd "$(dirname "$0")/.."

echo "==> configuring git hooks"
git config core.hooksPath .git-hooks 2>/dev/null || true
chmod +x .git-hooks/* 2>/dev/null || true

if [ ! -f .env ]; then
  echo "==> creating ignored .env (edit POSTGRES_* and AIRTABLE_* as needed)"
  if [ -f .env.example ]; then
    cp .env.example .env
  else
    cat > .env <<'ENV'
POSTGRES_DB=taskboard
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Tasks
ENV
  fi
  chmod 600 .env
fi

echo "==> installing backend dependencies"
cd backend
pip install -r requirements.txt
npm --prefix airtable ci --ignore-scripts

echo "==> running django migrations"
python manage.py migrate

echo "==> seeding database"
python manage.py seed

echo "==> running backend tests"
python -m pytest
cd ..

echo "==> installing frontend dependencies"
cd frontend
npm install

echo "==> running frontend tests"
npm test
cd ..

cat <<EOF

setup complete.

start backend:   cd backend && python manage.py runserver
start frontend:  cd frontend && npm run dev

or use Docker:   docker-compose up --build

then visit http://localhost:3000

EOF
